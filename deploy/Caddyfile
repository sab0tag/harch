# Production reverse proxy (compose.prod.yml). Caddy obtains and renews the Let's Encrypt
# certificate for $DOMAIN automatically; ports 80/443 must be reachable from the internet.
{$DOMAIN} {
	encode zstd gzip
	reverse_proxy web:8000
}

# www → the bare name: both addresses work, one canonical URL. Needs a DNS record for www too.
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

# S6-06: training copy (compose profile "demo"). Needs a DNS record for demo too.
demo.{$DOMAIN} {
	encode zstd gzip
	reverse_proxy demo-web:8000
}
