# Scheduler container (supercronic). Times are Europe/Kyiv (TZ set in compose).
# Order tasks for tomorrow appear shortly after midnight; orders are due D-1 16:00.
5 0 * * *     python manage.py generate_daily_tasks --days-ahead 1
# Catch-up in case the server was down at midnight (idempotent).
5 7 * * *     python manage.py generate_daily_tasks --days-ahead 1
*/15 * * * *  python manage.py check_deadlines
# Reference-data checks, weekly on Monday morning (apps/checks). AI suggestions only if AI_ENABLED.
40 6 * * 1    python manage.py run_checks
# Reference audit (AI-09): rules always; AI groups duplicate products only if AI_ENABLED and a key is set.
40 2 * * *    python manage.py audit_reference --ai
