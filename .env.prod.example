# Production .env (copy to .env on the server, chmod 600). Never commit the real file.
DOMAIN=harch.example.com
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=harch.example.com
# Long random string; put the same value into DATABASE_URL below.
POSTGRES_PASSWORD=
DATABASE_URL=postgres://harch:POSTGRES_PASSWORD@db:5432/harch
HOSPITAL_NAME=КНП "Центральна лікарня"
ORDER_DEADLINE=16:00

# AI (docs/07_ai.md)
AI_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
AI_DAILY_REQUEST_LIMIT=200

NOTIFY_EMAIL=false
EMAIL_URL=consolemail://

# Backups (deploy/backup, docs/06_deploy.md). Local copies in ./backups always; off-site if set.
BACKUP_KEEP_DAYS=14
# Hetzner Storage Box (SFTP). Password must be obscured:
#   docker compose -f compose.prod.yml run --rm backup rclone obscure 'storage-box-password'
BACKUP_REMOTE=offsite:harch-backups
RCLONE_CONFIG_OFFSITE_TYPE=sftp
RCLONE_CONFIG_OFFSITE_HOST=uXXXXXX.your-storagebox.de
RCLONE_CONFIG_OFFSITE_PORT=23
RCLONE_CONFIG_OFFSITE_USER=uXXXXXX
RCLONE_CONFIG_OFFSITE_PASS=
# Backblaze B2 instead: RCLONE_CONFIG_OFFSITE_TYPE=b2, RCLONE_CONFIG_OFFSITE_ACCOUNT=<keyID>,
# RCLONE_CONFIG_OFFSITE_KEY=<applicationKey>, BACKUP_REMOTE=offsite:<bucket>/harch

# Monitoring (S5-05, docs/06_deploy.md «Мониторинг»). Sentry is optional; empty = off.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# /healthz/full/ thresholds (defaults shown)
# HEALTH_SCHEDULER_MAX_AGE_MINUTES=45
# HEALTH_BACKUP_MAX_AGE_HOURS=26
