DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://harch:harch@db:5432/harch
HOSPITAL_NAME=КНП "Центральна лікарня"
HOSPITAL_CITY=м. Місто
# Printed forms; HOSPITAL_FULL_NAME empty = HOSPITAL_NAME
HOSPITAL_FULL_NAME=
HOSPITAL_EDRPOU=
HOSPITAL_ADDRESS=
APPROVER_TITLE=Директор
ORDER_DEADLINE=16:00
# Sign out after this many minutes without activity (shared department computers)
SESSION_IDLE_MINUTES=60

# AI (docs/07_ai.md). Key goes only here, never into git or chat.
AI_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Cheaper model for duplicates, menu review and dish drafts (apps/assist/client.py LIGHT_FEATURES); empty = main
ANTHROPIC_MODEL_LIGHT=claude-haiku-4-5
AI_DAILY_REQUEST_LIMIT=200

# Notifications: in-app always; email only when enabled and the user has an address
NOTIFY_EMAIL=false
EMAIL_URL=consolemail://
